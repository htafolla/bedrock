{
  "name": "bedrock",
  "version": "0.2.0-beta",
  "private": true,
  "type": "module",
  "description": "Bedrock — A Hitchhiker's Guide to Love · Living · Enduring. Do Better. Be Better. Trust God.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "xai:login": "node scripts/xai-oauth-login.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.49.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "vitest": "^3.2.4"
  }
}
