# Bedrock env template (copy to .env — never commit secrets)

# —— xAI Guide chat ——
# Prefer SuperGrok OAuth (npm run xai:login) OR console API key
# XAI_OAUTH_B64=
# XAI_OAUTH_TOKENS=
# XAI_API_KEY=
# XAI_MODEL=grok-4.5

# Durable OAuth + traffic (Postalocity MCP pattern)
# REDIS_URL=redis://default:…@redis.railway.internal:6379
#   → OAuth token SSOT + unique visitors / pageviews / door hits
# RAILWAY_API_TOKEN=   # account/workspace token (not project token) for env mirror
# XAI_OAUTH_PATH=      # optional file SSOT

# —— Privacy analytics ——
# First-party uniques always on via /api/telemetry (anonymous localStorage vid)

# Plausible (optional — set domain after adding site in Plausible)
# VITE_PLAUSIBLE_DOMAIN=bedrock.rippel.ai
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Also for static /c/* build:
# PLAUSIBLE_DOMAIN=bedrock.rippel.ai

# Umami self-host (optional alternative/in addition)
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=https://your-umami.example/script.js
# UMAMI_WEBSITE_ID=
# UMAMI_SRC=

# Protect summary endpoint (recommended in prod)
# TELEMETRY_KEY=long-random-string
